    <ToolTip x:Key="tooltip_scaffoldpage_import_csv_spots">
        <Grid Width="750">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        
            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Import a csv-file (*.csv) to print userdefined spot patterns.
                <LineBreak />Every line is a point/spot (the main information are comma separated).
                <LineBreak />Use following syntax: X,Y,Z,ToolID-NameWellPlate-Well,DropCount.
                <LineBreak />The ToolID is given on the ScaffoldPage, the name of the WellPlate must be exactly like in the configuration.
                <LineBreak />When you use the correct description for the ToolID, name of WellPlate and Well, the assignment to the spots will filled automatically.
                <LineBreak />If the ToolID or the name of WellPlate or the well is not given in the *.csv you can assign that manually in the scaffold page to the spots later.</TextBlock>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="10,0,10,10" HorizontalAlignment="Center">Example 1</TextBlock> 
                <Image Grid.Row="1" Grid.Column="0" Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_import_csv_spots_1.png" Margin="10" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" TextWrapping="Wrap" Margin="10,0,10,10" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Left">
                    <Span>
                        <Span>-3000,3000,0,1-Mtp96-</Span><Span Foreground="{StaticResource purple_light}">A1</Span><Span>,1</Span>
                    </Span>    
                    <LineBreak />
                    <Span>
                        <Span>-3000,1000,0,1-Mtp96-</Span><Span Foreground="{StaticResource purple_light}">A1</Span><Span>,1</Span>
                    </Span>    
                    <LineBreak />  
                    <Span>
                        <Span>-3000,-1000,0,1-Mtp96-</Span><Span Foreground="{StaticResource purple_light}">A1</Span><Span>,1</Span>
                    </Span>    
                    <LineBreak />  
                    <Span>
                        <Span>-3000,-3000,0,1-Mtp96-</Span><Span Foreground="{StaticResource purple_light}">A1</Span><Span>,1</Span>
                    </Span>    
                    <LineBreak />  
                    <Span>
                        <Span>-3000,3000,0,1-Mtp96-</Span><Span Foreground="{StaticResource purple_light}">A1</Span><Span>,1</Span>
                    </Span>    
                    <LineBreak />  
                    <Span>
                        <Span>-3000,1000,0,1-Mtp96-</Span><Span Foreground="{StaticResource purple_light}">A1</Span><Span>,1</Span>
                    </Span>    
