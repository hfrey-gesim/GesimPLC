    <ToolTip x:Key="tooltip_manualpage_actions_get_sample">
        <Grid Width="750">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Define the settings for the aspiration of the sample.</TextBlock>

            <Image Grid.Row="1" Grid.Column="0" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_get_sample.png" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </ToolTip>

    <ToolTip x:Key="tooltip_manualpage_actions_measure_tool_modes">
         <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Select the desired measure mode.</TextBlock>

            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">SlowApproach</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">=</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The measurement <Underline><Bold>(X/Y/Z)</Bold></Underline> of the tool will be started from the home position.</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The offset values of the tool (see configuration) will <Underline><Bold>not</Bold></Underline> be considered.</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Use this mode if you are <Underline><Bold>not</Bold></Underline> sure whether the configuration of the tool is right.</TextBlock>
                </Grid>

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">FastApproach</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">=</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The measurement <Underline><Bold>(X/Y/Z)</Bold></Underline> of the tool will be started close to the configured position.</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The offset values of the tool (see configuration) will be considered.</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Use this mode if you are sure that the configuration of the tool is almost right.</TextBlock>
                </Grid>

                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">OnlyXY</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">=</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The measurement <Underline><Bold>(X/Y)</Bold></Underline> of the tool will be started close to the configured position.</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The offset values of the tool (see configuration) will be considered.</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Use this mode if you are sure that the configuration of the tool is almost right.</TextBlock>
                </Grid>
            </Grid>    
        </Grid>  
    </ToolTip>

    <ToolTip x:Key="tooltip_manualpage_actions_set_pressure">
        <TextBlock>Set the required pressure/vacuum for the selected tool.<LineBreak />You can switch it on with the actions 'Switch Pressure', 'Switch Vacuum' or 'Switch Pressure/Vacuum' </TextBlock>
    </ToolTip>

    <ToolTip x:Key="tooltip_manualpage_actions_switch_pressure">
        <TextBlock>Switch on the previously set pressure/vacuum for the selected tool (see the actions 'Set Pressure' or 'Set Vacuum').<LineBreak />You can switch it on for a defined time or permanently till you switch it off.</TextBlock>
    </ToolTip>

    <ToolTip x:Key="tooltip_manualpage_actions_stampdemolding">
        <Grid Width="500">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Define the demolding process with a specific pressure/vacuum period and z movement.<LineBreak />The pressure/vacuum period will be repeated till the demolding distance is reached.</TextBlock>

            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"  VerticalAlignment="Center">
                    <TextBlock Text="Period = 1s" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Duty Cycle = 50%" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center">
                    <TextBlock Text="Period = 1s" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Duty Cycle = 75%" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource blue_light}"/>
                </StackPanel>

                <Image Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_stampdemolding_1.png" Margin="5,5,0,5" HorizontalAlignment="Center"/>
                
                <Image Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_stampdemolding_2.png" Margin="5,5,0,0" HorizontalAlignment="Center"/>

                <Image Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_stampdemolding_3.png" Margin="5,5,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </ToolTip>

    <ToolTip x:Key="tooltip_manualpage_actions_stampinking">
        <Grid Width="750">
