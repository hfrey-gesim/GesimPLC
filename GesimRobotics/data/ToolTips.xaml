<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<!-- ****************************** -->
<!-- ***** Configuration Page ***** -->
<!-- ****************************** -->
    
<!-- ***** General ***** -->

    <ToolTip x:Key="tooltip_configpage_general_new_open_save">
        <TextBlock>Only available when the software is disconnected to the machine.</TextBlock>
    </ToolTip>


<!-- ***** Properties ***** -->
    
    <ToolTip x:Key="tooltip_configpage_properties_feedsettings">
        <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10"  VerticalAlignment="Center">
                <TextBlock Text="Define a Compress- and RelaxeFeed to optimize the beginning and the end of the strand." Margin="0,0,0,10" HorizontalAlignment="Left"/>
                <TextBlock Text="Compress = Counteracts the inertia of the material." Margin="0,0,0,5" HorizontalAlignment="Left"/>
                <TextBlock Text="Relax = Counteracts the second reflection of the material." Margin="0,0,0,5" HorizontalAlignment="Left"/>
            </StackPanel> 

            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10"  VerticalAlignment="Center">
                    <TextBlock Text="CompressFeed = 0µs/s" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="CompressDistance = 0µm" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="RelaxFeed = 0µs/s" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="RelaxDistance = 0µm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="CompressFeed > 0µm/s" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                    <TextBlock Text="CompressDistance > 0µm" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                    <TextBlock Text="RelaxFeed = 0µs/s" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="RelaxDistance = 0µm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="CompressFeed > 0µm/s" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                    <TextBlock Text="CompressDistance > 0µm" Margin="0,0,0,15" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                    <TextBlock Text="RelaxFeed > 0µs/s" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                    <TextBlock Text="RelaxDistance > 0µm" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                </StackPanel>

                <Image Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/configpage_properties_extruders_feedsettings_1.png" Margin="5,5,0,5" HorizontalAlignment="Center"/>
                
                <Image Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/configpage_properties_extruders_feedsettings_2.png" Margin="5,5,0,5" HorizontalAlignment="Center"/>

                <Image Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/configpage_properties_extruders_feedsettings_3.png" Margin="5,5,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </ToolTip>



    <ToolTip x:Key="tooltip_configpage_properties_mtp_definitions">
        <Grid Width="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Define your specific well plate.</TextBlock>

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.12*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Source="/GesimRobotics;component/data/images/tooltips/configpage_properties_mtp_definitions_1.png" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="A - Offset Column 1" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                    <TextBlock Text="B - Offset Row 1" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                    <TextBlock Text="C - Space Columns" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                    <TextBlock Text="D - Space Rows" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                    <TextBlock Text="E - Well Diameter" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                    <TextBlock Text="F - Well Depth" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                    <TextBlock Text="G - Pre-Position (teachable)" Margin="0,0,0,5" HorizontalAlignment="Left"/>
                    <TextBlock Text="H - Working Depth (teachable)" Margin="0,0,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <Image Grid.Row="1" Grid.Column="1" Source="/GesimRobotics;component/data/images/tooltips/configpage_properties_mtp_definitions_2.png" Margin="10,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

            </Grid>
        </Grid>
    </ToolTip>

    <ToolTip x:Key="tooltip_configpage_properties_point_type">
        <TextBlock>Define the type of the point.<LineBreak />
            When the point types are well configured, the target selections will be less confusing.<LineBreak /><LineBreak />
            Regular = Available in all of the target selections (default type)<LineBreak />
            Calibration = Available in the 'move to target' and 'calibration point' selections (e.g. 'Calibrate Z-Sensor')<LineBreak />
            Print = Available in the 'move to target' and 'print point' selections (e.g. 'Scaffold Page')<LineBreak />
            Wait = Available in the 'move to target' and 'wait point' selections (e.g. 'Scaffold Page')
        </TextBlock>
    </ToolTip>

<!-- ******************************* -->
<!-- ********* Manual Page ********* -->
<!-- ******************************* -->

<!-- ***** Actions ***** -->

    <ToolTip x:Key="tooltip_manualpage_actions_actiononarray_distance_retract">
        <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Define a z movement with a defined speed between the spots. It is possible to use an additional Z-Offset Move, too. <LineBreak />If the Z-Offset Move + Z-Distance Retract is the same like the Z-Offset Action, there is no additional Z-Offset Move between the spots.<LineBreak />Necessary for special applications. </TextBlock>

            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10"  VerticalAlignment="Center">
                    <TextBlock Text="Z-Offset Action = 0.5mm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Offset Move = 1.0mm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Distance Retract = 0.0mm " Margin="0,0,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="Z-Offset Action = 0.5mm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Offset Move = 1.0mm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Distance Retract = 0.25mm " Margin="0,0,0,0" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                </StackPanel>

                <Image Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_actiononarray_distance_retract_1.png" Margin="5,5,0,5" HorizontalAlignment="Center"/>
                
                <Image Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_actiononarray_distance_retract_2.png" Margin="5,5,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </ToolTip>    


    <ToolTip x:Key="tooltip_manualpage_actions_actiononarray_offset_move">
        <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Define a z movement between the spots. <LineBreak />Necessary especially if there are borders between the spots. <LineBreak />If the Z-Offset Move is the same like the Z-Offset Action, there is no z movement between the spots.</TextBlock>

            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10"  VerticalAlignment="Center">
                    <TextBlock Text="Z-Offset Action = 1.0mm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Offset Move = 1.0" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Distance Retract = 0.0mm " Margin="0,0,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="Z-Offset Action = 0.5mm" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                    <TextBlock Text="Z-Offset Move = 1.0" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Distance Retract = 0.0mm " Margin="0,0,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Image Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_actiononarray_offset_move_1.png" Margin="5,5,0,5" HorizontalAlignment="Center"/>
                
                <Image Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_actiononarray_offset_move_2.png" Margin="5,5,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </ToolTip>

    <ToolTip x:Key="tooltip_manualpage_actions_actiononarray_start_retract">
        <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Define a z movement with a defined speed between the spots. You can activate this movement after or with the action. <LineBreak />Define a Retract Delay if the movement should not start directly with the action. It is possible to use an additional Z-Offset Move, too. <LineBreak />If the Z-Offset Move + Z-Distance Retract is the same like the Z-Offset Action, there is no additional Z-Offset Move between the spots.<LineBreak />Necessary for special applications. </TextBlock>

            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="10"  VerticalAlignment="Center">
                    <TextBlock Text="Z-Offset Action = 0.5mm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Offset Move = 1.0" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Distance Retract = 0.5mm" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="Start Retract = After Action" Margin="0,0,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="Z-Offset Action = 0.5mm" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Offset Move = 1.0" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="Z-Distance Retract = 0.5mm" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="Start Retract = With Action" Margin="0,0,0,0" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                </StackPanel>

                <Image Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_actiononarray_start_retract_1.png" Margin="5,5,0,5" HorizontalAlignment="Center"/>
                
                <Image Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Source="/GesimRobotics;component/data/images/tooltips/manualpage_actions_actiononarray_start_retract_2.png" Margin="5,5,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </ToolTip>

