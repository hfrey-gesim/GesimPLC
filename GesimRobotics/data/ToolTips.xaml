                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                    <TextBlock Text="InfillDistance = 500" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="OutlinePlus" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                    <TextBlock Text="MinLength = 0" Margin="0,0,0,5" HorizontalAlignment="Center"/>
