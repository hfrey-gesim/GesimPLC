    <ToolTip x:Key="tooltip_scaffoldpage_options_partial_print">
        <TextBlock>Prints only layers that start between the selected heights (inclusive).</TextBlock>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_options_path_smoothing">
        <Grid Width="750">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,10" HorizontalAlignment="Left">Smooths angles above the selected degree up to the selected tolerance to improve print quality.</TextBlock>


            <Grid Grid.Row="1" Margin="0,0,0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10">
                        <TextBlock Text="no path smoothing" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_1_1.png" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                        <TextBlock Text="angle > 120°" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_1_2.png" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="10">
                        <TextBlock Text="angle > 80°" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_1_3.png" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="10">
                        <TextBlock Text="angle > 35°" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_1_4.png" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="4" Margin="10">
                        <TextBlock Text="angle > 20°" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_1_5.png" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="no path smoothing" Margin="0,0,0,5" HorizontalAlignment="Center"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_2_1.png" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="deviation = 100µm" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_2_2.png" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10">
                        <TextBlock Text="deviation = 200µm" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_2_3.png" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="10">
                        <TextBlock Text="deviation = 300µm" Margin="0,0,0,5" HorizontalAlignment="Center" Foreground="{StaticResource darkyellow}"/>
                        <Image Source="/GesimRobotics;component/data/images/tooltips/scaffoldpage_options_path_smoothing_2_4.png" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_options_pausing">
        <TextBlock>Moves the tool to the selected wait point and pauses the selected time before continuing to print.<LineBreak />Use this option if your scaffold needs to cool between layers.<LineBreak />To only wait at the end, enter zero repeats.</TextBlock>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_options_toolorder">
        <TextBlock>Uses the tools in each layer in the selected order.</TextBlock>
    </ToolTip>

<!-- ***** Generate Buttons ***** -->

    <ToolTip x:Key="tooltip_scaffoldpage_gcode_generate">
        <TextBlock>Saves the scaffold as G-Code to be able to run it on the machine.</TextBlock>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_gcode_upload">
        <TextBlock>Uploads the current G-Code.</TextBlock>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_gcode_upload_cancel">
        <TextBlock>Stops the G-Code upload.</TextBlock>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_gcode_view">
        <TextBlock>Views the current G-Code.</TextBlock>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_grl_file">
        <TextBlock>Name of the grl-file.</TextBlock>
    </ToolTip>
    <ToolTip x:Key="tooltip_scaffoldpage_samples_assign">
        <TextBlock>Assign the samples to wells and set parameters.</TextBlock>
    </ToolTip>

<!-- ***** Viewers Block ***** -->

    <ToolTip x:Key="tooltip_scaffoldpage_viewers_min_max_z_height">
        <TextBlock>Show only the layers between the selected heights.<LineBreak />You can use the sliders to the left, too.</TextBlock>
    </ToolTip>

    <ToolTip x:Key="tooltip_scaffoldpage_viewers_qualitiy">
                <Grid Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Select the desired quality level for the visualization of the scaffold.</TextBlock>

            <Grid Grid.Row="1" Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Very Low</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">=</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The profile of the strand is a square with a low resolution of the shape.</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Use this quality level if the geometry is very big (high count of strands) or the processing power of your computer is to low.</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">If you are not sure, use the 'Very Low'-level at first and increase it after all is working well.</TextBlock>
                </Grid>

                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Low</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">=</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The profile of the strand is a square with a high resolution of the shape.</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Use this quality level if the geometry is very big (high count of strands) or the processing power of your computer is to low.</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">If you are not sure, use the 'Very Low'-level at first and increase it after all is working well.</TextBlock>
                </Grid>

                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">High</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">=</TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">The profile of the strand is a octagon with a high resolution of the shape.</TextBlock>
                    <TextBlock Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">Use this quality level if the processing power of your computer is high.</TextBlock>
                    <TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left">If you are not sure, use the 'Very Low'-level at first and increase it after all is working well.</TextBlock>
                </Grid>
            </Grid>    
        </Grid> 
    </ToolTip>

    <ToolTip x:Key="tooltip_scaffoldpage_viewers_show_details">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,0" HorizontalAlignment="Left" LineHeight="20">Select/deselect details of the scaffold, e.g. moving directions. 
            <LineBreak/>For droplet dispensers the moving path of the tool will shown as a line which connects the spots.
            <LineBreak/>
            <Span BaselineAlignment="Center">For extruder tools the start point will be labeled as a square</Span>
            <Span BaselineAlignment="TextBottom"><Polygon Points="0,0 15,0, 15,15 0,15" Stroke="White" Fill="White" /></Span>
            <Span BaselineAlignment="Center">and the end point with a circle</Span>
            <Span BaselineAlignment="TextBottom"><Ellipse Fill="White" Height="15" Width="15" Stroke="White" /></Span>
            <Span BaselineAlignment="Center">.</Span>
        </TextBlock>
    </ToolTip>

    <ToolTip x:Key="tooltip_scaffoldpage_viewers_show_grid">
        <TextBlock>Select/deselect to show a grid in the viewers.
            <LineBreak />The actual main grid is 1cm*1cm with an sub grid of 2mm*2mm.
            <LineBreak />The Origin of the Grid is the selected print point. The size of the grid is like the target where the print point is configured on.
            <LineBreak />The axes are colored in
                <Span Foreground="{StaticResource alarmred_light}">X = red</Span> and 
                <Span Foreground="{StaticResource green_light}">Y = green.</Span>
        </TextBlock>
    </ToolTip>

    <ToolTip x:Key="tooltip_scaffoldpage_viewers_show_print">
        <TextBlock>Select/deselect the tools which should be shown in the viewer.</TextBlock>
    </ToolTip>

    <ToolTip x:Key="tooltip_scaffoldpage_viewers_show_surface">
        <TextBlock>Select/deselect to visualize the surface of the 3D object.<LineBreak />You can use that function e.g. to find out the correct infill or outline offset for your scaffold.</TextBlock>
    </ToolTip>


    <ToolTip x:Key="tooltip_scaffoldpage_viewers_z_height">
        <TextBlock>Show only the layer on the selected height.<LineBreak />You can use the slider to the left, too.</TextBlock>
    </ToolTip>


